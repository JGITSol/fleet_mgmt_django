#: .\CarFleetManagement\templates\partials\_navbar.html:4
msgid "Car Fleet Manager"
msgstr "Gestor de Flota de Vehículos"

#: .\CarFleetManagement\templates\about.html:10
msgid "About Car Fleet Manager"
msgstr "Acerca del Gestor de Flota de Vehículos"

#: .\CarFleetManagement\templates\about.html:11
msgid ""
"A comprehensive fleet management system designed to leverage AI, automation, "
"and real-time data processing to streamline vehicle operations."
msgstr ""
"Un sistema integral de gestión de flotas diseñado para aprovechar la IA, la "
"automatización y el procesamiento de datos en tiempo real para optimizar las "
"operaciones de vehículos."

#: .\CarFleetManagement\templates\about.html:15
msgid "Our Mission"
msgstr "Nuestra Misión"

#: .\CarFleetManagement\templates\about.html:16
msgid ""
"To revolutionize fleet management through cutting-edge technology that "
"reduces costs, improves efficiency, and enhances safety for all fleet "
"operators."
msgstr ""
"Revolucionar la gestión de flotas a través de tecnología de vanguardia que "
"reduce costos, mejora la eficiencia y aumenta la seguridad para todos los "
"operadores de flotas."

#: .\CarFleetManagement\templates\about.html:22
msgid "Technology Stack"
msgstr "Stack Tecnológico"

#: .\CarFleetManagement\templates\about.html:24
msgid "Django 5.0 for robust backend services"
msgstr "Django 5.0 para servicios backend robustos"

#: .\CarFleetManagement\templates\about.html:25
msgid "PyTorch and YOLOv8 for advanced computer vision"
msgstr "PyTorch y YOLOv8 para visión por computadora avanzada"

#: .\CarFleetManagement\templates\about.html:26
msgid "PostgreSQL with PostGIS for geospatial capabilities"
msgstr "PostgreSQL con PostGIS para capacidades geoespaciales"

#: .\CarFleetManagement\templates\about.html:27
msgid "Modern web technologies for responsive interfaces"
msgstr "Tecnologías web modernas para interfaces responsivas"

#: .\CarFleetManagement\templates\about.html:34
msgid "The Team"
msgstr "El Equipo"

#: .\CarFleetManagement\templates\about.html:35
msgid ""
"Our team consists of experienced software engineers, data scientists, and "
"fleet management experts dedicated to building the best fleet management "
"solution on the market."
msgstr ""
"Nuestro equipo está formado por ingenieros de software experimentados, "
"científicos de datos y expertos en gestión de flotas dedicados a construir "
"la mejor solución de gestión de flotas del mercado."

